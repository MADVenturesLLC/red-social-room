{
  "name": "red-social-room",
  "version": "0.0.0",
  "private": true,
  "description": "MADVentures Red Social Room - Act 0 spike (provider scripts). No runtime dependencies.",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "check-node": "node spike/check-node.mjs",
    "typecheck": "node spike/check-node.mjs && tsc -p tsconfig.json",
    "test": "node spike/check-node.mjs && node --test \"spike/test/*.test.ts\"",
    "check-secrets": "node spike/check-node.mjs && node spike/check-secrets.ts",
    "ledger": "node spike/check-node.mjs && node spike/ledger-report.ts",
    "ledger:init": "node spike/check-node.mjs && node spike/ledger-init.ts",
    "ledger:reconcile": "node spike/check-node.mjs && node spike/ledger-reconcile.ts",
    "preflight": "node spike/check-node.mjs && node spike/preflight.ts",
    "spike:xai": "node spike/check-node.mjs && node spike/xai.ts",
    "spike:gemini": "node spike/check-node.mjs && node spike/gemini.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
